# Copie para .env e preencha. Nunca commite valores reais.

# URL do projeto (servidor). Opcional espelho público:
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"

# Chave publishable/anon — só INSERT via RLS. Não é service_role.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_YOUR_KEY"
VITE_SUPABASE_ANON_KEY="sb_publishable_YOUR_KEY"
SUPABASE_ANON_KEY="sb_publishable_YOUR_KEY"

# service_role — SOMENTE servidor. Nunca VITE_* / NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Postgres direto (opcional). Nunca commite senha real. Se uma URL antiga
# esteve no git, rotacione no Dashboard (Database settings → reset password)
# e atualize só o env do servidor.
# DATABASE_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres"

# Senha admin (>=12 caracteres). Sem default no código.
ADMIN_PASSWORD="replace-with-strong-password"

# HMAC das cookies de sessão (>=16 caracteres).
SESSION_SECRET="replace-with-long-random-secret"

# Bind. Use 0.0.0.0 só se o host precisar expor na rede.
HOST="127.0.0.1"
PORT="3000"

# 1 somente atrás de proxy confiável (senão o rate limit usa o IP do socket).
TRUST_PROXY="0"

# Arquivo do limiter (sobrevive a restart; mesmo path se houver mais de um processo na máquina).
# RATE_LIMIT_FILE="data/rate-limit.json"

APP_URL="https://your-app.example"
